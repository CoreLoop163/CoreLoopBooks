        int MinCost(int w[], int n) {
            priority_queue<int, vector<int>, greater<int>> min_heap;
            // 在下方完成你的代码
            int total_cost = 0;

            for(int i=0; i<n; i++) {
                min_heap.push(w[i]);
            }
            // 做n-1次
            for(int i=1; i<=n-1; i++) {
                // 取出两个重量最小的：w1和w2
                int w1 = min_heap.top();
                min_heap.pop();
                int w2 = min_heap.top();
                min_heap.pop();

                // 体力消耗为w1+w2
                int union_cost = w1 + w2;
                total_cost += union_cost;

                // 合成一堆后放回堆中
                min_heap.push(union_cost);
            }
            return total_cost;
        }
